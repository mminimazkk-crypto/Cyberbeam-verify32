# Discord OAuth2 application configuration
CLIENT_ID=your_discord_application_client_id
CLIENT_SECRET=your_discord_application_client_secret

# Bot configuration
BOT_TOKEN=your_discord_bot_token
GUILD_ID=your_discord_server_id
ROLE_ID=your_discord_role_id

# Must exactly match the callback URL configured in Discord:
# https://your-site.netlify.app/.netlify/functions/callback
REDIRECT_URI=https://your-site.netlify.app/.netlify/functions/callback